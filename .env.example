# Aily configuration — copy to .env and fill in.
# Aily is a single-user, Obsidian-first knowledge refinery: drop documents into
# the in-vault inbox folder and they are refined into Data/Information/Knowledge
# notes in your vault.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Absolute path to your Obsidian vault. The in-vault inbox drop zone is created
# at <vault>/00-Chaos/_inbox. Required — /ready reports an error if unset/missing.
OBSIDIAN_VAULT_PATH=/Users/you/Documents/aily-vault

# LLM provider for the DIKIWI pipeline. One of: kimi | deepseek | zhipu
LLM_PROVIDER=kimi
# Provider API key (or set the provider-specific key below). Required for the
# Data/Information/Knowledge pipeline; /ready reports an error if unset.
LLM_API_KEY=

# Provider-specific keys (optional if LLM_API_KEY is set for that provider)
KIMI_API_KEY=
DEEPSEEK_API_KEY=
ZHIPU_API_KEY=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Tavily web-research API key (only needed for the value workflow's research output)
TAVILY_API_KEY=

# In-vault inbox watcher (single folder that receives all dropped files)
INBOX_WATCHER_ENABLED=true
# Move processed originals to <inbox>/.processed so the vault stays clean
INBOX_ARCHIVE_PROCESSED=true
INBOX_POLL_INTERVAL_SECONDS=5

# Local data directory for queues, source store, and markdown packages
# AILY_DATA_DIR=~/.aily

# Number of concurrent source-processing workers
SOURCE_WORKER_COUNT=1

# ---------------------------------------------------------------------------
# Local API auth (leave disabled for a personal single-user setup)
# ---------------------------------------------------------------------------
# UI_AUTH_ENABLED=false
# UI_AUTH_TOKEN=
# HOSTED_MODE=false
